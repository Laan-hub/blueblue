# Lokale Entwicklung (DDEV). Siehe https://craftcms.com/docs/5.x/configure.html
# Beim ersten `ddev start` wird diese Datei automatisch nach .env kopiert.

CRAFT_APP_ID=blueblue
CRAFT_ENVIRONMENT=dev

# Wird bei der Einrichtung mit `ddev craft setup/security-key` gesetzt
CRAFT_SECURITY_KEY=

CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Datenbank (DDEV-Standardwerte)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

PRIMARY_SITE_URL=https://blueblue.ddev.site
