{% extends '_layouts/base' %}
{% import '_macros/ui.twig' as ui %}
{% import '_partials/crumbs' as c %}
{% set crumbs = c.forEntry(entry)|json_decode %}
{% set img = entry.image.one() ?? (entry.parent.image.one() ?? null) %}
{% set countryIds = [entry.id]|merge(entry.children.ids()) %}
{% set projects = craft.entries.section('projects').relatedTo({ targetElement: countryIds, field: 'countries' }).all() %}
{% set stories = craft.entries.section(['akzente', 'news']).relatedTo({ targetElement: countryIds, field: 'countries' }).limit(3).all() %}
{% block content %}
  <header class="entry-head container">
    <div class="entry-head__top">{% include '_partials/breadcrumb' %}</div>
    <p class="eyebrow">{{ entry.level == 1 ? 'Region'|t : 'Country'|t }}{% if entry.parent %} / {{ entry.parent.title }}{% endif %}</p>
    <div class="entry-head__grid">
      <h1 class="h-page">{{ entry.title }}</h1>
      <div class="entry-head__aside">{% if entry.summary %}<p class="lead">{{ entry.summary }}</p>{% endif %}</div>
    </div>
  </header>
  {% if img %}
    <figure class="entry-hero">{{ ui.img(img, { ratio: 1440/420, sizes: '100vw', eager: true }) }}</figure>
  {% endif %}

  {% if entry.children|length %}
    <section class="block bg-tinted">
      <div class="container split">
        <div class="split__aside"><p class="eyebrow">{{ 'Countries'|t }}</p><h2 class="h-section">{{ 'Where we work'|t }}</h2></div>
        <ul class="region-list split__main">
          {% for child in entry.children.all() %}
            <li><a href="{{ child.url }}"><span class="region-list__name">{{ child.title }}</span><span class="region-list__countries">{{ child.summary }}</span>{{ ui.icon('arrow') }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </section>
  {% endif %}

  {% include '_blocks/_builder' with { blocks: entry.builder.all(), hasPageH1: true } %}

  <section class="block bg-subtle block-teasers">
    <div class="container">
      <header class="section-head"><div class="section-head__text"><p class="eyebrow">{{ 'Projects'|t }}</p><h2 class="h-display">{{ 'Our work in {place}'|t({ place: entry.title }) }}</h2></div></header>
      {% if projects|length %}
        <div class="teaser-grid teaser-grid--cards">{% for p in projects %}{% include '_components/teaser' with { entry: p, variant: 'cards' } only %}{% endfor %}</div>
      {% else %}
        <p class="lead-sm">{{ 'No projects have been published for this location yet.'|t }}</p>
      {% endif %}
    </div>
  </section>
  {% if stories|length %}
    <section class="block block-teasers">
      <div class="container">
        <header class="section-head"><div class="section-head__text"><p class="eyebrow">{{ 'Stories & updates'|t }}</p><h2 class="h-section">{{ 'More from {place}'|t({ place: entry.title }) }}</h2></div></header>
        <div class="teaser-grid teaser-grid--media">{% for s in stories %}{% include '_components/teaser' with { entry: s, variant: 'media' } only %}{% endfor %}</div>
      </div>
    </section>
  {% endif %}
{% endblock %}
