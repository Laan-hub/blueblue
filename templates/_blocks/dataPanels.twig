{% import '_macros/ui.twig' as ui %}
{% set colors = ['var(--c-brand)', 'var(--c-sky)', 'var(--c-green)', 'var(--c-amber)', 'var(--c-navy)'] %}
<section class="block-panels bg-subtle">
  <div class="container">
    <div class="panels">
      {% for p in block.panels.all() %}
        <article class="panel">
          {{ ui.eyebrow(p.eyebrow) }}
          <h3 class="h-panel">{{ p.headline }}</h3>
          {% if p.type.handle == 'progressPanel' %}
            {% if p.lead %}<p class="panel__lead">{{ p.lead }}</p>{% endif %}
            <ul class="bars">
              {% for r in p.progressItems %}
                {% set pct = r.max ? (r.value / r.max * 100)|round : 0 %}
                <li class="bar bar--{{ r.style ?: 'actual' }}">
                  <p class="bar__label"><span>{{ r.label }}</span><strong>{{ r.value }}</strong></p>
                  <span class="bar__track" role="img" aria-label="{{ r.value }} / {{ r.max }} ({{ pct }} %)"><span class="bar__fill" style="width: {{ pct }}%"></span></span>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <div class="stack" role="img" aria-label="{{ p.allocationItems|map(a => a.label ~ ' ' ~ a.percent ~ '%')|join(', ') }}">
              {% for a in p.allocationItems %}<span style="width: {{ a.percent }}%; background: {{ colors[loop.index0 % 5] }}"></span>{% endfor %}
            </div>
            <table class="legend">
              <caption class="visually-hidden">{{ p.headline }}</caption>
              <tbody>
                {% for a in p.allocationItems %}
                  <tr>
                    <th scope="row"><span class="legend__swatch" style="background: {{ colors[loop.index0 % 5] }}"></span>{{ a.label }}</th>
                    <td>{{ a.percent }}%</td>
                    <td><strong>{{ a.amount }}</strong></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          {% endif %}
          {% if p.note %}<p class="small-note">{{ p.note }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if block.note %}<p class="small-note">{{ block.note }}</p>{% endif %}
  </div>
</section>
